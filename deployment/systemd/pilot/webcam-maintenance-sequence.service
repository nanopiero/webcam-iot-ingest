[Unit]
Description=Failure-tolerant daily webcam discovery and database backup
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=codexuser
Group=codexuser
WorkingDirectory=/home/codexuser/src/webcam-iot-ingest
ExecStart=/home/codexuser/src/webcam-iot-ingest/deployment/maintenance/run daily
TimeoutStartSec=infinity
